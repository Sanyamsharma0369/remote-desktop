# ─────────────────────────────────────────────
#  Remote Desktop — Environment Configuration
#  Copy to .env and fill in real values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Server ──────────────────────────────────
APP_ENV=development
# Bind only to loopback in production (use reverse proxy for public access)
HOST=127.0.0.1
PORT=9005
DEBUG=false

# ── Public origin (used in CORS, HSTS, CSP) ─
# Development: leave empty or http://localhost:9005
# Production: set to your public HTTPS domain, e.g. https://rd.example.com
PUBLIC_ORIGIN=
ALLOWED_ORIGINS=http://localhost:9005,http://127.0.0.1:9005
ALLOWED_WS_ORIGINS=http://localhost:9005,http://127.0.0.1:9005

# ── Auth ─────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
ALGORITHM=HS256

# Access token: short-lived (15 min for production, up to 60 for dev)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token: longer-lived opaque token stored in HttpOnly cookie
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookie security ───────────────────────────
# Set true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Narrow cookie path for refresh token
REFRESH_COOKIE_PATH=/api/auth/refresh

# ── Session / control ─────────────────────────
# Auto-expire Screen Control mode after inactivity (minutes)
CONTROL_SESSION_EXPIRE_MINUTES=10
# One-time WS ticket TTL (seconds)
WEBSOCKET_TICKET_EXPIRE_SECONDS=60
# Maximum concurrent control sessions per device
MAX_CONCURRENT_CONTROL_SESSIONS_PER_DEVICE=1

# ── WebSocket limits ──────────────────────────
MAX_WS_MESSAGE_BYTES=65536
MAX_MOUSE_EVENTS_PER_SECOND=60
MAX_CONTROL_EVENTS_PER_SECOND=120

# ── Audit ─────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=90

# ── Database ──────────────────────────────────
DATABASE_URL=sqlite:///./rd_app.db

# ── Streaming ─────────────────────────────────
CAPTURE_FPS=30
MONITOR_INDEX=1
ENCODER=auto

# ── Keyboard security flags ───────────────────
ALLOW_ALT_F4=false
ALLOW_CTRL_SHIFT_ESC=false

# ── Initial admin bootstrap ───────────────────
# Set this ONCE to create the first admin account on startup.
# Must be at least 12 characters; weak/common values are rejected.
# Once any admin user exists in the database, this setting is ignored.
# After first login, remove or rotate this value.
# NEVER set to "admin123" or any known-bad value.
INITIAL_ADMIN_PASSWORD=
